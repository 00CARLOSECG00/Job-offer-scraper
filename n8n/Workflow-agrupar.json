    {
      "parameters": {
        "jsCode": "const items = $input.all().map(item => item.json);\n\nconst mapaHabilidades = {};\n\nfor (const fila of items) {\n  const nombre = (fila.Habilidad_Faltante || \"\").trim();\n  if (!nombre) continue;\n\n  const conteoFila = parseInt(fila.Conteo) || 1;\n  const fechaFila = new Date(fila.Ultima_Vez_Vista || Date.now());\n\n  // Si es la primera vez que vemos esta habilidad en el bucle, la registramos\n  if (!mapaHabilidades[nombre]) {\n    mapaHabilidades[nombre] = {\n      Habilidad_Faltante: nombre,\n      Conteo: 0,\n      Ultima_Vez_Vista: fechaFila\n    };\n  }\n\n  // Sumar el conteo\n  mapaHabilidades[nombre].Conteo += conteoFila;\n\n  // Conservar la fecha de la vez más reciente que apareció\n  if (fechaFila > mapaHabilidades[nombre].Ultima_Vez_Vista) {\n    mapaHabilidades[nombre].Ultima_Vez_Vista = fechaFila;\n  }\n}\n\n// Convertir el mapa de vuelta al formato que entiende n8n\nconst resultado = Object.values(mapaHabilidades).map(hab => {\n  const d = hab.Ultima_Vez_Vista;\n  const fechaStr = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;\n\n  return {\n    json: {\n      Habilidad_Faltante: hab.Habilidad_Faltante,\n      Conteo: hab.Conteo,\n      Ultima_Vez_Vista: fechaStr\n    }\n  };\n});\n\n// Ordenar las habilidades para que las más demandadas queden de primeras\nresultado.sort((a, b) => b.json.Conteo - a.json.Conteo);\n\nreturn resultado;"
      },
